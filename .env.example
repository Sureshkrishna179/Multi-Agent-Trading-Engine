# ============================================
# Multi-Agent Trading Bot — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Google Gemini AI (Sentiment Agent) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Indian Market Broker APIs (Optional — for live execution) ---
# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Dhan HQ
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=

# --- Crypto Exchange APIs (Optional — for live execution) ---
# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Delta Exchange India
DELTA_API_KEY=
DELTA_API_SECRET=

# --- Trading Configuration ---
EXECUTION_MODE=PAPER          # PAPER or LIVE
DEFAULT_CAPITAL_INR=100000    # ₹1,00,000 default paper capital (Indian)
DEFAULT_CAPITAL_USD=10000     # $10,000 default paper capital (Crypto)
MAX_RISK_PER_TRADE=0.02       # 2% max risk per trade
